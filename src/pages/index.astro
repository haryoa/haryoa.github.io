---
// The front page: a short intro, then the two doors of the site (CV and Blog).
import { Image } from "astro:assets";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "../components/BaseHead.astro";
import { FiMail, FiGithub, FiLinkedin, FiTwitter, FiArrowRight, FiFileText, FiEdit3 } from "react-icons/fi";
import { SiGooglescholar } from "react-icons/si";
import { blogs, formatDate } from "../data/blogs";
import "../styles/main.css";

const profile = {
  name: "Haryo Akbarianto Wibowo",
  tagline: "PhD Student @ MBZUAI",
  image: "/images/profile.png",
  email: "haryo.akbarianto@gmail.com",
  social: {
    github: "https://github.com/haryoa",
    twitter: "https://twitter.com/haryoaw",
    linkedin: "https://www.linkedin.com/in/haryoaw/",
    scholar: "https://scholar.google.com/citations?user=X5tK6xsAAAAJ&hl=en",
  },
};
const latest = blogs[0];
const socials = [
  { href: `mailto:${profile.email}`, label: "Email", Icon: FiMail },
  { href: profile.social.github, label: "GitHub", Icon: FiGithub },
  { href: profile.social.twitter, label: "Twitter", Icon: FiTwitter },
  { href: profile.social.linkedin, label: "LinkedIn", Icon: FiLinkedin },
  { href: profile.social.scholar, label: "Google Scholar", Icon: SiGooglescholar },
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead />
  </head>
  <body>
    <div class="min-h-screen flex flex-col bg-gradient-to-b from-white via-[#F5F1E8]/40 to-white">
      <nav class="fixed top-0 left-0 w-full bg-white/80 backdrop-blur-sm z-40 border-b border-[#4A5D4F]/5">
        <Navbar />
      </nav>

      <main class="flex-1 pt-28 pb-20 px-6">
        <div class="max-w-3xl mx-auto">
          <!-- intro -->
          <section class="flex flex-col sm:flex-row items-center gap-8 sm:gap-10">
            <div class="relative shrink-0">
              <Image src={profile.image} alt={`Photo of ${profile.name}`} width={176} height={176}
                class="w-40 h-40 rounded-full object-cover ring-4 ring-white shadow-sm" />
              <div class="absolute -inset-1 rounded-full bg-gradient-to-br from-[#4A5D4F]/20 to-[#B87E5F]/25 -z-10"></div>
            </div>
            <div class="text-center sm:text-left">
              <h1 class="text-3xl sm:text-4xl font-light tracking-wide text-[#4A5D4F]">{profile.name}</h1>
              <p class="mt-1 text-[#4A5D4F]/70">{profile.tagline}</p>
              <div class="mt-3 mx-auto sm:mx-0 w-12 h-px bg-[#B87E5F]/50"></div>
              <p class="mt-4 text-[#2C2C2C] leading-relaxed">
                I work on making language models learn more efficiently: objective functions, knowledge
                distillation, and the data we train on. Here you can find my CV and my blog, where I write
                about deep learning, technical things I build, and sometimes just life.
              </p>
              <div class="mt-5 flex justify-center sm:justify-start gap-4">
                {socials.map(({ href, label, Icon }) => (
                  <a href={href} aria-label={label} target={href.startsWith("mailto") ? undefined : "_blank"} rel="noopener noreferrer"
                    class="text-[#4A5D4F] hover:text-[#B87E5F] transition-colors duration-200 hover:scale-110 transform">
                    <Icon size="1.35em" />
                  </a>
                ))}
              </div>
            </div>
          </section>

          <!-- the two doors -->
          <section class="mt-14 grid sm:grid-cols-2 gap-5">
            <a href="/cv/" class="group rounded-2xl border border-[#4A5D4F]/10 bg-white/90 p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
              <div class="flex items-center gap-3 text-[#4A5D4F]">
                <span class="grid place-items-center w-10 h-10 rounded-xl bg-[#4A5D4F]/10"><FiFileText size="1.25em" /></span>
                <h2 class="text-xl font-medium">CV</h2>
              </div>
              <p class="mt-3 text-sm text-[#2C2C2C]/80">Know me better! My education, publications, experience, talks, and professional activities.</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm text-[#B87E5F] group-hover:gap-2 transition-all">View CV <FiArrowRight /></span>
            </a>
            <a href="/blogs/" class="group rounded-2xl border border-[#4A5D4F]/10 bg-white/90 p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
              <div class="flex items-center gap-3 text-[#4A5D4F]">
                <span class="grid place-items-center w-10 h-10 rounded-xl bg-[#B87E5F]/15 text-[#B87E5F]"><FiEdit3 size="1.25em" /></span>
                <h2 class="text-xl font-medium">Blog</h2>
              </div>
              <p class="mt-3 text-sm text-[#2C2C2C]/80">Deep learning deep dives, hands-on technical write-ups on applications, and sometimes just personal stuff.</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm text-[#B87E5F] group-hover:gap-2 transition-all">Read the blog <FiArrowRight /></span>
            </a>
          </section>

          <!-- latest post -->
          {latest && (
            <section class="mt-12">
              <p class="text-xs uppercase tracking-widest text-[#4A5D4F]/60">Latest post</p>
              <a href={`/blogs/${latest.slug}/`} class="group mt-3 block rounded-2xl border border-[#4A5D4F]/10 bg-gradient-to-br from-white to-[#F5F1E8]/60 p-6 hover:shadow-md transition-all duration-300">
                <p class="text-xs text-[#4A5D4F]/60">{formatDate(latest.date)}</p>
                <h3 class="mt-1 text-lg font-medium text-[#4A5D4F] group-hover:text-[#B87E5F] transition-colors">{latest.title}</h3>
                <p class="mt-2 text-sm text-[#2C2C2C]/80">{latest.summary}</p>
              </a>
            </section>
          )}
        </div>
      </main>

      <Footer />
    </div>
  </body>
</html>
