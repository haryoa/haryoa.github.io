---
import { AnimatedLogo, BackButton } from "./NavbarMotion";

interface Props {
  showBackButton?: boolean;
}

const { showBackButton = false } = Astro.props;
---

<nav
  class="w-full bg-gradient-to-r from-white/80 via-white/90 to-white/80 backdrop-blur-sm transition-all duration-300 hover:bg-white/95
  before:absolute before:inset-x-0 before:bottom-0 before:h-[1px] before:bg-gradient-to-r before:from-transparent before:via-[#4A5D4F]/10 before:to-transparent"
>
  <div class="max-w-screen-2xl mx-auto px-8">
    <div class="flex justify-between items-center h-16">
      <div class="w-1/3 flex items-center gap-8">
        {showBackButton && <BackButton client:load />}
      </div>

      <div class="w-1/3 flex justify-center">
        <AnimatedLogo client:load />
      </div>

      <div class="w-1/3 flex justify-end items-center space-x-6 text-sm">
        <a href="/cv/" class="text-[#4A5D4F] hover:text-[#B87E5F] transition-colors duration-200">CV</a>
        <a href="/blogs/" class="text-[#4A5D4F] hover:text-[#B87E5F] transition-colors duration-200">Blog</a>
      </div>
    </div>
  </div>
</nav>
