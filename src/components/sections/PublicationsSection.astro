---
import { Icon } from "astro-icon/components";

interface Props {
  publications: any[];
}

const { publications } = Astro.props;
const myName = "Haryo Akbarianto Wibowo"; // Replace with your actual name

// Featured papers first, then newest first
const sortedPublications = [...publications].sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.year - a.data.year
);
const filterTypes = ["conference", "journal", "workshop", "preprint"].filter((t) =>
  publications.some((p) => p.data.type === t)
);

// Helper function to format authors list with HTML
const formatAuthors = (authors: string[]) => {
  return authors
    .map((author) =>
      author === myName ? `<strong>${author}</strong>` : author
    )
    .join(", ");
};
---

<>
  <div class="relative">
    <div
      class="absolute inset-0 bg-gradient-to-br from-white via-[#F5F1E8]/20 to-white rounded-lg"
    >
    </div>

    <div class="relative z-10">
      <h2 class="text-3xl font-light tracking-wide text-[#4A5D4F] group mb-8">
        Publications
        <div
          class="h-0.5 w-0 group-hover:w-full bg-gradient-to-r from-[#4A5D4F] to-[#B87E5F] transition-all duration-500"
        >
        </div>
      </h2>

      <div
        class="flex gap-4 mb-8 overflow-x-auto pb-2 scrollbar-thin scrollbar-thumb-[#B87E5F]/20 scrollbar-track-transparent"
      >
        <button
          data-filter-btn="all"
          onclick="setPubFilter('all')"
          class="px-4 py-2 rounded-lg transition-all duration-300 bg-[#4A5D4F] text-white hover:shadow-lg hover:scale-105 active:scale-95"
        >
          All
        </button>
        {
          filterTypes.map((type) => (
            <button
              data-filter-btn={type}
              onclick={`setPubFilter('${type}')`}
              class="px-4 py-2 rounded-lg transition-all duration-300 bg-white/50 text-[#4A5D4F] hover:bg-[#4A5D4F]/10 hover:shadow-md hover:scale-105 active:scale-95"
            >
              {type.charAt(0).toUpperCase() + type.slice(1)}
            </button>
          ))
        }
      </div>

      <div class="grid gap-6">
        {
          sortedPublications.map((pub) => (
            <div
              data-pub
              data-type={pub.data.type}
              class:list={[
                "rounded-lg p-6 shadow-sm border transition-all duration-500 hover:shadow-md relative",
                pub.data.featured
                  ? "bg-gradient-to-r from-[#B87E5F]/5 via-white to-[#B87E5F]/10 border-[#B87E5F]/30 hover:border-[#B87E5F]/50 hover:shadow-[#B87E5F]/10 hover:shadow-lg"
                  : "bg-white/80 backdrop-blur-sm border-[#4A5D4F]/10 hover:border-[#B87E5F]/30"
              ]}
            >
              {pub.data.featured && (
                <div class="absolute -top-3 right-4 px-3 py-1 bg-gradient-to-r from-[#B87E5F] to-[#A36D50] text-white text-sm rounded-full shadow-md shadow-[#B87E5F]/20 animate-shine">
                  ✨ Featured
                </div>
              )}
              <h3 class="text-xl font-medium text-[#4A5D4F] mb-2">
                <a
                  href={pub.data.links?.[0]?.url ?? "#"}
                  class="hover:text-[#B87E5F] transition-colors duration-200"
                >
                  {pub.data.title}
                </a>
              </h3>
              <p class="text-sm text-[#2C2C2C] mb-2">
                <span set:html={formatAuthors(pub.data.authors)} />
              </p>
              <p class="text-sm text-[#2C2C2C]/80 mb-4">
                {pub.data.venue} • {pub.data.year}
              </p>
              {pub.data.links && (
                <div class="flex gap-3">
                  {pub.data.links.map((link: { text: string; url: string }) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-1 px-3 py-1 text-sm rounded-md bg-gray-50 text-gray-700 hover:bg-gray-100 transition-colors duration-200"
                    >
                      <Icon
                        name={
                          link.text.toLowerCase() === "arxiv"
                            ? "mdi:file-document"
                            : link.text.toLowerCase() === "paper"
                              ? "mdi:file-pdf-box"
                              : link.text.toLowerCase() === "dataset"
                                ? "mdi:database"
                                : link.text.toLowerCase() === "code"
                                  ? "mdi:github"
                                  : "mdi:link"
                        }
                        class="w-4 h-4"
                      />
                      {link.text}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <style>
    /* Add smooth scrollbar styling */
    .scrollbar-thin::-webkit-scrollbar {
      height: 6px;
    }

    .scrollbar-thin::-webkit-scrollbar-track {
      background: transparent;
    }

    .scrollbar-thin::-webkit-scrollbar-thumb {
      background: rgba(184, 126, 95, 0.2);
      border-radius: 3px;
    }

    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
      background: rgba(184, 126, 95, 0.4);
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }
    
    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes shine {
      0% {
        background-position: 200% center;
      }
      100% {
        background-position: -200% center;
      }
    }

    .animate-shine {
      background: linear-gradient(
        120deg,
        #B87E5F 0%,
        #A36D50 25%,
        #8A5A40 50%,
        #A36D50 75%,
        #B87E5F 100%
      );
      background-size: 200% auto;
      animation: shine 4s linear infinite;
    }
  </style>
</>
