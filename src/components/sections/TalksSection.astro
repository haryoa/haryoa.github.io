---
import type { CollectionEntry } from "astro:content";
import TalkCard from '../TalkCard';

const { talks } = Astro.props as { talks: CollectionEntry<"talks">[] };
---

<div class="space-y-6">
  <h2
    class="text-3xl font-light tracking-wide text-[#4A5D4F] relative inline-block group"
  >
    Talks
    <div
      class="absolute -bottom-2 left-0 w-0 h-px bg-[#B87E5F] group-hover:w-full transition-all duration-500"
    >
    </div>
  </h2>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      talks.map((talk, index) => (
        <TalkCard client:visible talk={talk} index={index} />
      ))
    }
  </div>
</div>
